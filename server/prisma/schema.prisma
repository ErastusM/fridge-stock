// Fridge stock — Lighthouse group, Swakopmund.
// Batches are the truth (what is physically in a fridge, with its use-by date);
// movements are the append-only history. Both are written in one transaction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FridgeKind {
  WALK_IN
  REACH_IN
  PREP
  BAR
  FREEZER
}

enum Unit {
  EACH
  KG
  L
  PORTION
  PACK
}

enum Role {
  STAFF
  MANAGER
  OWNER
}

enum MovementType {
  ADD
  TAKE
  WASTE
  ADJUST
  TRANSFER_OUT
  TRANSFER_IN
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String   @unique
  timezone  String   @default("Africa/Windhoek")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  fridges Fridge[]
  items   Item[]
  staff   Staff[]
}

model Fridge {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  kind         FridgeKind @default(REACH_IN)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  items        FridgeItem[]
  batches      Batch[]
  movements    Movement[]
  devices      Device[]
  pairingCodes PairingCode[]

  @@unique([restaurantId, name])
}

model Item {
  id                   String     @id @default(cuid())
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id])
  name                 String
  category             String     @default("General")
  unit                 Unit       @default(EACH)
  defaultShelfLifeDays Int        @default(3)
  active               Boolean    @default(true)
  createdAt            DateTime   @default(now())

  fridgeItems FridgeItem[]
  batches     Batch[]
  movements   Movement[]

  @@unique([restaurantId, name])
}

/// An item stocked in a fridge, with its reorder thresholds. The row is also the
/// per-(fridge, item) lock every stock change takes.
model FridgeItem {
  id       String @id @default(cuid())
  fridgeId String
  fridge   Fridge @relation(fields: [fridgeId], references: [id])
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  minQty   Float  @default(0)
  parLevel Float  @default(0)

  @@unique([fridgeId, itemId])
}

model Batch {
  id           String   @id @default(cuid())
  fridgeId     String
  fridge       Fridge   @relation(fields: [fridgeId], references: [id])
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  qtyRemaining Float
  expiresAt    DateTime
  receivedAt   DateTime @default(now())

  @@index([fridgeId, itemId])
}

model Movement {
  id            String       @id @default(cuid())
  fridgeId      String
  fridge        Fridge       @relation(fields: [fridgeId], references: [id])
  itemId        String
  item          Item         @relation(fields: [itemId], references: [id])
  type          MovementType
  /// Positive for every type except ADJUST, where it is the signed correction.
  qty           Float
  /// Stock of this item in this fridge after the movement.
  qtyAfter      Float
  staffId       String
  staff         Staff        @relation(fields: [staffId], references: [id])
  deviceId      String?
  device        Device?      @relation(fields: [deviceId], references: [id])
  reason        String?
  /// Use-by of the batch added (ADD / TRANSFER_IN).
  expiresAt     DateTime?
  /// Links the two halves of a transfer.
  transferGroup String?
  /// Idempotency key from the tablet, so a retried request never counts twice.
  clientId      String?      @unique
  createdAt     DateTime     @default(now())

  @@index([fridgeId, createdAt])
  @@index([createdAt])
}

model Staff {
  id                String      @id @default(cuid())
  /// null only for OWNER (all restaurants).
  restaurantId      String?
  restaurant        Restaurant? @relation(fields: [restaurantId], references: [id])
  name              String
  role              Role        @default(STAFF)
  /// HMAC-SHA256 of the PIN under PIN_SECRET; unique among the people who can use the same tablet.
  pinDigest         String
  email             String?     @unique
  passwordHash      String?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())

  movements Movement[]

  @@index([pinDigest])
}

model Device {
  id                String    @id @default(cuid())
  fridgeId          String
  fridge            Fridge    @relation(fields: [fridgeId], references: [id])
  name              String
  tokenHash         String    @unique
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  lastSeenAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  movements Movement[]
}

model PairingCode {
  id         String    @id @default(cuid())
  fridgeId   String
  fridge     Fridge    @relation(fields: [fridgeId], references: [id])
  deviceName String
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([codeHash])
}
